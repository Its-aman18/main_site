# =========================================================================
# ZERO → ONE / Code.SCRIET Digital Simulation Platform
# Environment Configuration — copy to .env (never commit .env)
# Targets the Oracle VM layout: https://zero-one.codescriet.dev → 127.0.0.1:5003
# =========================================================================

# --- Server & Network ---
# Prod backend port (standalone server serves dist/ + /api same-origin).
# Dev frontend is fixed at :5175 (see vite.config.ts); playground owns :5174.
PORT=5003
ZERO_ONE_PORT=5003
HOST=0.0.0.0
NODE_ENV=production

# --- Monorepo connection (same values as apps/api + apps/playground) ---
# Shared session secret — MUST equal the main API JWT_SECRET so zero-one can
# verify main-site JWTs (Authorization: Bearer / scriet_session cookie).
# Alternate names accepted: JWT_SECRET_KEY, AUTH_JWT_SECRET, AUTH_SECRET.
JWT_SECRET=replace_with_the_same_secret_as_the_main_api
# Main web origin (sign-in redirects, CORS).
FRONTEND_URL=https://codescriet.dev
# Extra allowed browser origins (comma-separated) for split deployments.
# Same-origin prod needs none of these; dev ports are auto-allowed when
# NODE_ENV != production.
ALLOWED_ORIGIN=https://zero-one.codescriet.dev,https://codescriet.dev,https://www.codescriet.dev

# --- Main-site integration (frontend build-time) ---
# Main API origin for session validation (/api/auth/me).
VITE_MAIN_API_URL=https://api.codescriet.dev
# Main web origin for sign-in redirects.
VITE_MAIN_SITE_URL=https://codescriet.dev
# Zero-one backend origin for SPLIT deployments only (frontend and backend on
# different origins). Leave unset for the default same-origin layout.
# VITE_ZERO_ONE_API_URL=https://zero-one.codescriet.dev

# --- Bootstrap Administration ---
# Venue super-admin email. Rotatable without a code change (the built-in
# default only applies when this is unset). Frontend override (build-time):
# VITE_BOOTSTRAP_SUPERADMIN_EMAIL
BOOTSTRAP_SUPERADMIN_EMAIL=applicationinformation73737@gmail.com

# --- Event Authority & Economics (build-time, baked into the frontend) ---
# Two-Key CFO->CEO high value purchase threshold in INR (Official: 100000)
VITE_TWO_KEY_APPROVAL_THRESHOLD=100000
VITE_INITIAL_VIRTUAL_CAPITAL=1000000
VITE_SIMULATION_RNG_SEED=zero-one-scriet-2026

# --- Production Code.SCRIET Identity (Optional External OAuth / SSO) ---
# When disabled or unset, platform runs in self-contained LAN fallback mode.
CODE_SCRIET_SSO_ENABLED=false
CODE_SCRIET_SSO_ENDPOINT=https://codescriet.dev/api/auth
CODE_SCRIET_CLIENT_ID=zero_one_venue_client_placeholder
CODE_SCRIET_CLIENT_SECRET=placeholder_secret_never_commit

# --- Optional Production Persistence (PostgreSQL / Supabase / Prisma) ---
# Reserved for a future DB-backed engine. Unset today: the authoritative
# state is in-memory with JSON snapshot files (see below).
DATABASE_URL=postgresql://user:password@localhost:5432/zero_one_event?schema=public

# --- Recovery & Snapshots ---
ZERO_ONE_RECOVER_LATEST=false
SNAPSHOT_STORAGE_DIR=scratch/snapshots
